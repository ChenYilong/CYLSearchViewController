{
  "name": "entry",
  "version": "1.0.0",
  "description": "The CYLSearchViewController example for HarmonyOS: a 1:1 copy of the iOS example, on cylsearch, CYLTabBarController's cyltabbar, CYLTableViewPlaceHolder's cylplaceholder and CollectionViewClassifyMenu's classifymenu (on CYLTabBarController's cylanimateditem, which it re-exports); every animation plays through CYLTabBarController's engine views (cylanimateditem GIF and SVGA, cylanimateditem_lottie, cylanimateditem_pag, cylanimateditem_rive), registered in entry/src/main/ets/animation.",
  "main": "",
  "author": "ChenYilong",
  "license": "MIT",
  "dependencies": {
    "cylsearch": "file:../cylsearch",
    "cyltabbar": "file:../vendor/cyltabbar",
    "cylanimateditem": "file:../vendor/cylanimateditem",
    "cylanimateditem_lottie": "file:../vendor/cylanimateditem_lottie",
    "cylanimateditem_pag": "file:../vendor/cylanimateditem_pag",
    "cylanimateditem_rive": "file:../vendor/cylanimateditem_rive",
    "cylplaceholder": "file:../vendor/cylplaceholder",
    "@cyl/classifymenu": "file:../vendor/classifymenu",
    "@ohos/lottie": "2.0.38",
    "@tencent/libpag": "4.5.102",
    "@ohos/rive": "1.0.4"
  }
}
