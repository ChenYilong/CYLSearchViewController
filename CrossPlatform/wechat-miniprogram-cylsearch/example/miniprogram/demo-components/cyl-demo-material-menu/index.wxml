<view class="screen">
  <cyl-demo-nav title="MaterialSearchView" />
  <view class="inset-group">
    <view wx:for="{{rows}}" wx:key="sample" class="cell" role="button" aria-label="{{item.title}}" data-sample="{{item.sample}}" bindtap="onRow">
      <text class="cell-title">{{item.title}}</text>
      <view class="chevron" aria-hidden="true" />
    </view>
  </view>
</view>
