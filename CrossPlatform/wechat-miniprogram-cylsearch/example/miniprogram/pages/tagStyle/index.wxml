<view class="page">
  <cyl-search-bar placeholder="Search languages" searchBarStyle="bordered" bind:focuschange="openSearch" />
  <view class="hint">Tag style with the keyboard down (focusesSearchFieldOnShow false) and the empty-cache placeholder.</view>
  <view class="event">{{lastEvent}}</view>
  <cyl-search id="search" generic:cyl-animation-view="cyl-lottie" emptySuggestionsAnimation="/assets/placeholder/CYLPlaceholderNoDrafts.json" suggestions="{{suggestions}}" suggestionStyle="tags" placeholder="Search languages"
    searchBarStyle="bordered" cacheName="MiniProgramTags" focusesSearchFieldOnShow="{{false}}" animationSpeed="{{animationSpeed}}" animationLoops="{{animationLoops}}" bind:submit="onSubmit">
    <view slot="placeholder-footer" class="playback" aria-label="Animation playback" aria-value="{{animationPlaybackDescription}}">
      <button class="play-all" size="mini" bindtap="onPlayAll" aria-label="Play all animations from the start">Play all</button>
      <view class="playback-row">
        <text>Speed {{animationSpeed}}x</text>
        <slider class="playback-slider" min="1" max="12" step="1" value="{{animationSpeedStep}}" bindchanging="onSpeedChange" bindchange="onSpeedChange"
          aria-label="Animation speed" aria-valuetext="{{animationSpeed}}x" />
      </view>
      <view class="playback-row">
        <text>Loop</text>
        <switch checked="{{animationLoops}}" bindchange="onLoopChange" aria-label="Loop animations" />
      </view>
    </view>
  </cyl-search>
</view>
