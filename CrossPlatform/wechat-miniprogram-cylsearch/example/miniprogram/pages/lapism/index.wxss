.screen { display: flex; flex-direction: column; height: 100vh; background: #fff; }
.list { flex: 1; min-height: 0; }
.results { min-height: 100%; }
.row { padding: 11px 16px; font-size: 17px; color: #000; border-bottom: 1px solid #e5e5ea; }
@media (prefers-color-scheme: dark) { .screen { background: #000; } .row { color: #fff; border-color: #38383a; } }
