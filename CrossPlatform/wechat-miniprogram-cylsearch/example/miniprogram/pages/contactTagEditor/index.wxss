/* A fixed-height column: the <scroll-view> (.list) is the only scroller, so holding its scroll-y (while a tag is dragged) really holds the scrolling. With min-height the whole page grew and scrolled instead. */
.screen { height: 100vh; overflow: hidden; background: #fff; display: flex; flex-direction: column; }
.actions { display: flex; align-items: center; }
.sync { width: 40px; height: 40px; line-height: 40px; text-align: center; font-size: 22px; color: #576B95; }
.done { margin-left: 4px; padding: 0 12px; height: 32px; line-height: 32px; border-radius: 4px; font-size: 17px; font-weight: 600;
  color: rgba(60, 60, 67, 0.3); background: rgba(120, 120, 128, 0.16); }
.done-on { color: #fff; background: #07C160; }
.search { margin: 8px 8px 0; }
.list { flex: 1; height: 0; min-height: 0; }
/* While managing, the editing bar takes the page's bottom. */
.list-managing { padding-bottom: 64px; box-sizing: border-box; }
.header { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px 4px; }
.header-title { font-size: 15px; color: rgba(60, 60, 67, 0.6); }
.manage { font-size: 15px; color: #576B95; }
.create { display: inline-block; margin: 4px 16px 16px; padding: 0 14px; height: 36px; line-height: 36px; border-radius: 6px;
  border: 1px solid #c6c6c8; font-size: 15px; color: #000; }
.placeholder { padding: 48px 16px; display: flex; justify-content: center; }
