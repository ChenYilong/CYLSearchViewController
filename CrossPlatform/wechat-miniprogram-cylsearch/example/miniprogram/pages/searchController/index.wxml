<view class="page">
  <cyl-demo-nav title="{{title}}" />
  <!-- QDSearchViewController: the bar is the header of the list; the launch view, the results and the empty view fill the space
       under it, all from the core's options; the search bar never covers a view. -->
  <cyl-search id="search" class="host" generic:cyl-lottie-view="cyl-lottie" generic:cyl-pag-view="cyl-animation-placeholder" generic:cyl-rive-view="cyl-animation-placeholder" generic:cyl-svga-view="cyl-svga" style="height: {{hostHeight}}px" showsSearchBar showsContent
    suggestions="{{suggestions}}" showsSuggestionsLaunchView supportsSwipeToDismissSearch highlightsResultMatches noResultsText="{{noResultsText}}"
    results="{{results}}" placeholder="{{placeholder}}" cacheName="CYLSearchControllerDemo" closesOnSubmit="{{false}}" navigationIcon="none"
    bind:updateresults="onUpdateResults">
    <view slot="content" class="keywords">
      <view wx:for="{{keywords}}" wx:key="*this" class="cell" role="button" aria-label="{{item}}" id="CYLSearchControllerRow-{{index}}">
        <text class="cell-title">{{item}}</text>
      </view>
    </view>
  </cyl-search>
</view>
