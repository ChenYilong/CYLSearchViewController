.screen { display: flex; flex-direction: column; align-items: stretch; height: calc(100vh - 50px - env(safe-area-inset-bottom)); background: #fff; }
.entry-title { font-size: 20px; font-weight: 700; color: #000; text-align: center; margin-top: 30vh; }
@media (prefers-color-scheme: dark) {
  .screen { background: #000; }
  .entry-title { color: #fff; }
}
