.screen { display: flex; flex-direction: column; align-items: center; justify-content: center; height: calc(100vh - 50px - env(safe-area-inset-bottom)); background: #fff; }
.entry-title { font-size: 20px; font-weight: 700; color: #000; margin-bottom: 16px; }
.entry-button { min-height: 44px; padding: 0 28px; line-height: 44px; border-radius: 22px; background: #007aff; color: #fff; font-size: 17px; }
@media (prefers-color-scheme: dark) {
  .screen { background: #000; }
  .entry-title { color: #fff; }
}
