<view class="page">
  <cyl-demo-nav title="{{title}}" />
  <!-- QDSearchBarViewController: the bar is the header of the list. The core's content page is the one scroller. -->
  <cyl-search id="search" class="host" generic:cyl-lottie-view="cyl-lottie" generic:cyl-pag-view="cyl-animation-placeholder" generic:cyl-rive-view="cyl-animation-placeholder" generic:cyl-svga-view="cyl-svga" style="height: {{hostHeight}}px" showsSearchBar showsContent placeholder="{{placeholder}}"
    centersPlaceholder="{{centersPlaceholder}}" showsLeadingView="{{showsLeading}}" showsTrailingAccessoryViews="{{showsTrailing}}"
    leadingAccessoryMargins="{{leadingMargins}}" trailingAccessoryMargins="{{trailingMargins}}"
    scrimColor="rgba(0, 0, 0, 0.4)" cacheName="CYLSearchBarStyles" appearance="{{appearance}}" backgroundColor="#f2f2f7">
    <view slot="leading" class="accessory" style="border-color: {{leadingColor}}" role="img" aria-label="{{texts.accessory}}" />
    <view slot="trailing" class="accessory" style="border-color: {{trailingColor}}" role="img" aria-label="{{texts.accessory}}" />
    <view slot="content" class="styles">
      <block wx:for="{{sections}}" wx:for-item="section" wx:key="title">
        <view class="group-header" role="heading">{{section.title}}</view>
        <view class="group">
          <view wx:for="{{section.rows}}" wx:key="id" class="cell" role="button" aria-label="{{item.text}}" aria-description="{{texts.hint}}"
            id="CYLSearchBarStylesRow-{{item.id}}" data-id="{{item.id}}" bindtap="onRow">
            <text class="cell-title">{{item.text}}</text>
            <switch wx:if="{{item.switch}}" checked="{{item.on}}" data-id="{{item.id}}" catchtap="noop" bindchange="onSwitch" aria-label="{{item.text}}" />
          </view>
        </view>
      </block>
    </view>
  </cyl-search>
</view>
