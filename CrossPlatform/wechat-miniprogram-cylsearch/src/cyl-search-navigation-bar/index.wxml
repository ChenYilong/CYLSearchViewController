<!-- The navigation bar: status bar space, then the back button (optional) and the search bar in the slot. -->
<view class="cyl-nav" style="{{barStyle}}">
  <view wx:if="{{showsBack}}" class="cyl-nav-back" role="button" aria-label="{{back}}" bindtap="onBack">
    <view class="cyl-nav-back-icon" aria-hidden="true" />
  </view>
  <view class="cyl-nav-content" style="{{contentStyle}}"><slot /></view>
</view>
