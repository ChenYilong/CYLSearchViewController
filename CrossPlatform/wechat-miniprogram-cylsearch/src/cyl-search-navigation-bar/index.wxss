.cyl-nav { display: flex; align-items: center; box-sizing: content-box; background: transparent; }
.cyl-nav-back { flex: none; display: flex; align-items: center; justify-content: center; width: 0; height: 44px; margin-left: 0; margin-right: 0; opacity: 0; overflow: hidden; pointer-events: none; }
.cyl-nav-back-shown { width: 32px; margin-left: -10px; margin-right: 2px; opacity: 1; pointer-events: auto; }
/* The animated change (the first-level push and its return): the slot grows or shrinks, the flex bar follows it. */
.cyl-nav-animated .cyl-nav-back { transition: width 0.25s ease-in-out, margin 0.25s ease-in-out, opacity 0.25s ease-in-out; }
.cyl-nav-back-icon { width: 20px; height: 20px; background-color: #007aff; -webkit-mask-size: contain; mask-size: contain; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-position: center; mask-position: center; -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M15 4l-8 8 8 8'/></svg>"); mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M15 4l-8 8 8 8'/></svg>"); }
.cyl-nav-content { flex: 1; min-width: 0; position: relative; }
.cyl-nav-tap { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
