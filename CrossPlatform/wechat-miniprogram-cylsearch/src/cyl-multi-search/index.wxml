<!-- Several searches side by side (iOS CYLMultiSearchView): the items in a row, the field of a new search, the search button. -->
<view class="cyl-multi">
  <scroll-view scroll-x class="cyl-multi-row" enhanced show-scrollbar="{{false}}">
    <view class="cyl-multi-items">
      <view wx:for="{{items}}" wx:key="index" class="cyl-multi-item" style="opacity: {{index === selectedIndex ? 1 : unselectedItemAlpha}}">
        <view class="cyl-multi-text" role="button" aria-label="{{item.label}}" aria-selected="{{index === selectedIndex}}"
          data-index="{{index}}" bindtap="onItemTap" style="font-size: {{fontSize}}px; {{textColor ? 'color: ' + textColor : ''}}">{{item.text}}</view>
        <view wx:if="{{index === selectedIndex}}" class="cyl-multi-remove" role="button" aria-label="{{labels.remove}}" data-index="{{index}}" bindtap="onRemoveTap">
          <view class="cyl-multi-icon cyl-multi-xmark" style="{{indicatorColor ? 'background-color: ' + indicatorColor : ''}}" aria-hidden="true" />
        </view>
        <view wx:if="{{index === selectedIndex}}" class="cyl-multi-indicator" style="{{indicatorColor ? 'background: ' + indicatorColor : ''}}" />
      </view>
      <view wx:if="{{typing}}" class="cyl-multi-item" style="width: {{searchFieldWidth}}px">
        <input class="cyl-multi-input" value="{{typedText}}" focus="{{focus}}" placeholder="{{placeholderText}}"
          placeholder-style="{{placeholderColor ? 'color: ' + placeholderColor : ''}}" confirm-type="{{returnKeyType}}"
          maxlength="{{maximumTextLength > 0 ? maximumTextLength : -1}}" style="font-size: {{fontSize}}px; {{textColor ? 'color: ' + textColor : ''}}"
          bindinput="onInput" bindconfirm="onConfirm" />
        <view class="cyl-multi-indicator" style="{{indicatorColor ? 'background: ' + indicatorColor : ''}}" />
      </view>
    </view>
  </scroll-view>
  <view class="cyl-multi-button" role="button" aria-label="{{typing ? placeholderText : labels.add}}" bindtap="onSearchButton">
    <view class="cyl-multi-icon cyl-multi-search-icon" style="{{indicatorColor ? 'background-color: ' + indicatorColor : ''}}" aria-hidden="true" />
  </view>
</view>
