.cyl-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 200; display: flex; flex-direction: column; background: #fff; opacity: 0; transform: translateY(44px); transition: opacity 0.25s, transform 0.25s; }
.cyl-overlay-entered { opacity: 1; transform: translateY(0); }
.cyl-overlay-top { display: flex; align-items: center; height: 44px; padding: 0 0 0 16px; box-sizing: content-box; }
.cyl-overlay-cancel { color: #007aff; font-size: 17px; line-height: 44px; }
.cyl-overlay-list { flex: 1; min-height: 0; }
.cyl-overlay-row { padding: 11px 16px; font-size: 17px; color: #000; border-bottom: 1px solid #e5e5ea; }
@media (prefers-color-scheme: dark) {
  .cyl-overlay { background: #000; }
  .cyl-overlay-row { color: #fff; border-color: #38383a; }
}
